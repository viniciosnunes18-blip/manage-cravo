{
  "name": "Product",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "C\u00f3digo do produto (ex: BRDCH120)"
    },
    "name": {
      "type": "string",
      "description": "Nome do produto"
    },
    "category": {
      "type": "string",
      "description": "Categoria do produto"
    },
    "price": {
      "type": "number",
      "description": "Pre\u00e7o de venda"
    },
    "cost": {
      "type": "number",
      "description": "Custo de fabrica\u00e7\u00e3o"
    },
    "profit_margin": {
      "type": "number",
      "description": "Margem de lucro (%)"
    },
    "markup_percentage": {
      "type": "number",
      "description": "Markup (%)"
    },
    "description": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs das fotos (at\u00e9 3)"
    },
    "branch_id": {
      "type": "string",
      "description": "Filial que possui o produto"
    },
    "quantity_in_stock": {
      "type": "number",
      "default": 0,
      "description": "Quantidade em estoque"
    },
    "quantity_in_field": {
      "type": "number",
      "default": 0,
      "description": "Quantidade em campo (com revendedoras)"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Produto em destaque"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "weight": {
      "type": "string",
      "description": "Peso da pe\u00e7a"
    },
    "material": {
      "type": "string",
      "description": "Material da pe\u00e7a"
    }
  },
  "required": [
    "code",
    "name",
    "price"
  ]
}