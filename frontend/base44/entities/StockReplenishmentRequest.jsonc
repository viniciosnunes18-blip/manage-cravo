{
  "name": "StockReplenishmentRequest",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string",
      "description": "ID da filial solicitante"
    },
    "branch_name": {
      "type": "string",
      "description": "Nome da filial"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending",
        "approved",
        "partial",
        "fulfilled",
        "cancelled"
      ],
      "default": "draft",
      "description": "Status do pedido"
    },
    "request_date": {
      "type": "string",
      "format": "date",
      "description": "Data da solicita\u00e7\u00e3o"
    },
    "approved_date": {
      "type": "string",
      "format": "date",
      "description": "Data da aprova\u00e7\u00e3o"
    },
    "fulfilled_date": {
      "type": "string",
      "format": "date",
      "description": "Data do envio"
    },
    "approved_by": {
      "type": "string",
      "description": "Nome de quem aprovou"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    },
    "total_items_requested": {
      "type": "number",
      "description": "Total de itens solicitados"
    },
    "total_value_requested": {
      "type": "number",
      "description": "Valor total solicitado"
    },
    "items": {
      "type": "array",
      "description": "Itens do pedido de reposi\u00e7\u00e3o",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_code": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "unit_price": {
            "type": "number"
          },
          "current_stock": {
            "type": "number",
            "description": "Estoque atual na filial"
          },
          "quantity_sold_month": {
            "type": "number",
            "description": "Quantidade vendida no m\u00eas"
          },
          "quantity_sold_week": {
            "type": "number",
            "description": "Velocidade de venda semanal"
          },
          "days_of_coverage": {
            "type": "number",
            "description": "Dias de cobertura do estoque atual"
          },
          "suggested_quantity": {
            "type": "number",
            "description": "Quantidade sugerida pelo sistema"
          },
          "requested_quantity": {
            "type": "number",
            "description": "Quantidade solicitada pelo gestor"
          },
          "approved_quantity": {
            "type": "number",
            "description": "Quantidade aprovada pela matriz"
          },
          "replenishment_urgency": {
            "type": "string",
            "enum": [
              "critical",
              "urgent",
              "normal",
              "low"
            ],
            "description": "N\u00edvel de urg\u00eancia"
          },
          "justification": {
            "type": "string",
            "description": "Justificativa baseada em m\u00e9tricas"
          }
        }
      }
    }
  },
  "required": [
    "branch_id",
    "items"
  ]
}