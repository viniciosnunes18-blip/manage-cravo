{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "matriz",
        "filial",
        "revendedora"
      ],
      "default": "user",
      "description": "N\u00edvel de acesso do usu\u00e1rio"
    },
    "branch_id": {
      "type": "string",
      "description": "ID da filial vinculada (para filial e revendedora)"
    },
    "branch_name": {
      "type": "string",
      "description": "Nome da filial (cache)"
    },
    "first_access": {
      "type": "boolean",
      "default": false,
      "description": "Se true, exige cria\u00e7\u00e3o de senha pessoal no pr\u00f3ximo login"
    }
  }
}