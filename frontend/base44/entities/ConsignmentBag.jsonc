{
  "name": "ConsignmentBag",
  "type": "object",
  "properties": {
    "reseller_id": {
      "type": "string",
      "description": "ID da revendedora"
    },
    "reseller_name": {
      "type": "string"
    },
    "branch_id": {
      "type": "string",
      "description": "ID da filial"
    },
    "branch_name": {
      "type": "string"
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_code": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "sold",
              "returned",
              "damaged"
            ]
          }
        }
      },
      "description": "Produtos na pasta"
    },
    "total_value": {
      "type": "number",
      "description": "Valor total da pasta"
    },
    "total_sold": {
      "type": "number",
      "default": 0,
      "description": "Total vendido"
    },
    "settlement_due_date": {
      "type": "string",
      "format": "date",
      "description": "Data limite para acerto"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "partial",
        "settled",
        "overdue",
        "returned"
      ],
      "default": "open"
    },
    "settlement_date": {
      "type": "string",
      "format": "date",
      "description": "Data do acerto realizado"
    },
    "commission_amount": {
      "type": "number",
      "default": 0,
      "description": "Valor da comiss\u00e3o calculada"
    },
    "penalty_amount": {
      "type": "number",
      "default": 0,
      "description": "Valor de penalidade por atraso"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "reseller_id",
    "branch_id"
  ]
}