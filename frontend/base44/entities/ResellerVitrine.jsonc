{
  "name": "ResellerVitrine",
  "type": "object",
  "properties": {
    "reseller_id": {
      "type": "string"
    },
    "unique_code": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico para URL p\u00fablica"
    },
    "welcome_message": {
      "type": "string",
      "description": "Mensagem de boas-vindas personalizada"
    },
    "whatsapp_number": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "visible_product_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos produtos vis\u00edveis na vitrine"
    },
    "visit_count": {
      "type": "number",
      "default": 0
    },
    "interest_clicks": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "reseller_id",
    "unique_code"
  ]
}