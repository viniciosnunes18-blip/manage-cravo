{
  "name": "ProductSalesMetrics",
  "properties": {
    "avg_weekly_sales": {
      "description": "M\u00e9dia de vendas por semana",
      "type": "number"
    },
    "branch_id": {
      "description": "ID da filial",
      "type": "string"
    },
    "branch_name": {
      "description": "Nome da filial",
      "type": "string"
    },
    "category": {
      "description": "Categoria do produto",
      "type": "string"
    },
    "current_stock": {
      "description": "Estoque atual na filial",
      "type": "number"
    },
    "days_of_coverage": {
      "description": "Dias de cobertura com estoque atual",
      "type": "number"
    },
    "last_sale_date": {
      "description": "Data da \u00faltima venda",
      "format": "date",
      "type": "string"
    },
    "last_updated": {
      "description": "Ultima atualiza\u00e7\u00e3o das m\u00e9tricas",
      "format": "date-time",
      "type": "string"
    },
    "needs_replenishment": {
      "default": false,
      "description": "Se precisa de reposi\u00e7\u00e3o",
      "type": "boolean"
    },
    "product_code": {
      "description": "C\u00f3digo do produto",
      "type": "string"
    },
    "product_id": {
      "description": "ID do produto",
      "type": "string"
    },
    "product_name": {
      "description": "Nome do produto",
      "type": "string"
    },
    "replenishment_point": {
      "description": "Ponto de reposi\u00e7\u00e3o (estoque m\u00ednimo sugerido)",
      "type": "number"
    },
    "replenishment_urgency": {
      "default": "low",
      "description": "N\u00edvel de urg\u00eancia de reposi\u00e7\u00e3o",
      "enum": [
        "critical",
        "urgent",
        "normal",
        "low"
      ],
      "type": "string"
    },
    "suggested_replenishment_qty": {
      "description": "Quantidade sugerida para reposi\u00e7\u00e3o",
      "type": "number"
    },
    "total_sold_last_30_days": {
      "description": "Total vendido nos \u00faltimos 30 dias",
      "type": "number"
    },
    "total_sold_last_7_days": {
      "description": "Total vendido nos \u00faltimos 7 dias",
      "type": "number"
    },
    "total_sold_last_90_days": {
      "description": "Total vendido nos \u00faltimos 90 dias",
      "type": "number"
    },
    "unit_price": {
      "description": "Pre\u00e7o unit\u00e1rio do produto",
      "type": "number"
    }
  },
  "required": [
    "product_id",
    "branch_id"
  ],
  "type": "object"
}