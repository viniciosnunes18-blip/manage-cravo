{
  "name": "Reseller",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Nome completo"
    },
    "cpf": {
      "type": "string",
      "description": "CPF da revendedora"
    },
    "rg": {
      "type": "string",
      "description": "RG da revendedora"
    },
    "birth_date": {
      "type": "string",
      "format": "date",
      "description": "Data de nascimento"
    },
    "email": {
      "type": "string",
      "description": "E-mail"
    },
    "phone": {
      "type": "string",
      "description": "Telefone/WhatsApp principal"
    },
    "phone2": {
      "type": "string",
      "description": "Telefone/contato adicional"
    },
    "address": {
      "type": "string",
      "description": "Endere\u00e7o completo (rua, n\u00famero, bairro)"
    },
    "city": {
      "type": "string",
      "description": "Cidade"
    },
    "state": {
      "type": "string",
      "description": "Estado"
    },
    "zip_code": {
      "type": "string",
      "description": "CEP"
    },
    "has_formal_job": {
      "type": "boolean",
      "default": false,
      "description": "Tem emprego formal?"
    },
    "formal_job_description": {
      "type": "string",
      "description": "Qual emprego formal / o que faz"
    },
    "how_found_us": {
      "type": "string",
      "description": "Como conheceu a Cravo Dourado"
    },
    "branch_id": {
      "type": "string",
      "description": "ID da filial mais pr\u00f3xima"
    },
    "branch_name": {
      "type": "string",
      "description": "Nome da filial"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "active",
        "inactive",
        "blocked"
      ],
      "default": "pending",
      "description": "Status do cadastro"
    },
    "cpf_check_status": {
      "type": "string",
      "enum": [
        "pending",
        "clean",
        "restricted"
      ],
      "default": "pending",
      "description": "Resultado da consulta de CPF"
    },
    "commission_level": {
      "type": "string",
      "enum": [
        "bronze",
        "silver",
        "gold",
        "diamond"
      ],
      "default": "bronze",
      "description": "N\u00edvel de comiss\u00e3o atual"
    },
    "total_sold_period": {
      "type": "number",
      "default": 0,
      "description": "Total vendido no per\u00edodo atual"
    },
    "contract_signed": {
      "type": "boolean",
      "default": false
    },
    "contract_date": {
      "type": "string",
      "format": "date"
    },
    "profile_photo": {
      "type": "string",
      "description": "URL da foto de perfil"
    },
    "password_hash": {
      "type": "string",
      "description": "Hash da senha"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es internas"
    },
    "referred_by_reseller_id": {
      "type": "string",
      "description": "ID da revendedora que indicou este cadastro"
    }
  },
  "required": [
    "full_name",
    "cpf",
    "phone",
    "branch_id"
  ]
}