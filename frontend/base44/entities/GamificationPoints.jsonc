{
  "name": "GamificationPoints",
  "type": "object",
  "properties": {
    "reseller_id": {
      "type": "string",
      "description": "ID da revendedora"
    },
    "reseller_name": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "points": {
      "type": "number",
      "default": 0,
      "description": "Total de pontos acumulados"
    },
    "points_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "points": {
            "type": "number"
          },
          "description": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Hist\u00f3rico de pontos ganhos/perdidos"
    },
    "expires_at": {
      "type": "string",
      "format": "date",
      "description": "Data de expira\u00e7\u00e3o dos pontos (12 meses)"
    }
  },
  "required": [
    "reseller_id",
    "branch_id"
  ]
}