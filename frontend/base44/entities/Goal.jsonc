{
  "name": "Goal",
  "properties": {
    "branch_id": {
      "description": "null = meta global",
      "type": "string"
    },
    "branch_name": {
      "type": "string"
    },
    "current_value": {
      "default": 0,
      "description": "Valor atual atingido",
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "end_date": {
      "format": "date",
      "type": "string"
    },
    "is_active": {
      "default": true,
      "type": "boolean"
    },
    "period": {
      "description": "Ex: Maio/2026",
      "type": "string"
    },
    "start_date": {
      "format": "date",
      "type": "string"
    },
    "target_type": {
      "description": "Tipo da meta",
      "enum": [
        "sales_value",
        "new_resellers",
        "active_resellers",
        "bags_released"
      ],
      "type": "string"
    },
    "target_value": {
      "description": "Valor alvo da meta",
      "type": "number"
    },
    "title": {
      "description": "Ex: Meta de Vendas Maio 2026",
      "type": "string"
    }
  },
  "required": [
    "title",
    "target_type",
    "target_value"
  ],
  "type": "object"
}