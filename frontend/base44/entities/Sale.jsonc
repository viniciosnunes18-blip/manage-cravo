{
  "name": "Sale",
  "type": "object",
  "properties": {
    "reseller_id": {
      "type": "string"
    },
    "reseller_name": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "bag_id": {
      "type": "string",
      "description": "ID da pasta de consignado"
    },
    "product_id": {
      "type": "string"
    },
    "product_code": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "sale_price": {
      "type": "number"
    },
    "sale_date": {
      "type": "string",
      "format": "date"
    },
    "warranty_end_date": {
      "type": "string",
      "format": "date",
      "description": "Data de fim da garantia (1 ano ap\u00f3s venda)"
    },
    "warranty_sent": {
      "type": "boolean",
      "default": false,
      "description": "Garantia virtual enviada ao consumidor"
    },
    "customer_name": {
      "type": "string",
      "description": "Nome do consumidor final"
    },
    "customer_phone": {
      "type": "string",
      "description": "Telefone do consumidor final"
    }
  },
  "required": [
    "reseller_id",
    "product_id",
    "sale_price"
  ]
}